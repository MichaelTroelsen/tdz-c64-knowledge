# .claude/tasks/runs.jsonl and whattask.json are append-only tooling output,
# always written with bare LF, and shared between machines via git. Without
# this, core.autocrlf=true here would materialise them as CRLF on a fresh
# clone/checkout, diverging from what the tooling appends and producing a
# mixed-ending file.
.claude/tasks/* eol=lf

# wiki_assets/ holds the CSS and JS the wiki export emits verbatim. The
# exporter reads them with newline='' and writes them with the platform
# translation, which is what gives the exported wiki its CRLF endings. If a
# checkout materialised these as CRLF they would be translated a second time
# and every emitted asset would gain doubled line endings.
wiki_assets/** eol=lf
