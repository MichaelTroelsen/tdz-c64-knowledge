# TDZ C64 Knowledge Base - Environment Configuration

# ============================================================
# Data Storage
# ============================================================
# Directory for database and index storage
# Default: ~/.tdz-c64-knowledge
TDZ_DATA_DIR=C:\Users\YourName\.tdz-c64-knowledge

# ============================================================
# Search Configuration
# ============================================================
# Enable SQLite FTS5 full-text search (recommended for best performance)
# 0 = disabled, 1 = enabled
# Default: 0
USE_FTS5=1

# Enable semantic search with embeddings (conceptual/meaning-based search)
# 0 = disabled, 1 = enabled
# Default: 0
USE_SEMANTIC_SEARCH=1

# Sentence-transformers model for semantic search
# Default: all-MiniLM-L6-v2
# Other options: all-mpnet-base-v2, paraphrase-MiniLM-L6-v2
SEMANTIC_MODEL=all-MiniLM-L6-v2

# Enable BM25 search algorithm (fallback)
# 0 = disabled, 1 = enabled
# Default: 1
USE_BM25=1

# Enable NLTK query preprocessing (stopword removal, stemming)
# 0 = disabled, 1 = enabled
# Default: 1
USE_QUERY_PREPROCESSING=1

# ============================================================
# Security Configuration
# ============================================================
# Comma-separated list of allowed document directories (path traversal protection)
# Always allowed regardless of this setting: <TDZ_DATA_DIR>/scraped_docs,
# .../downloads, .../temp, .../uploads. Leaving this empty does NOT disable
# the whitelist - it just means only those default directories are allowed.
# Example: C:\Users\YourName\Documents\C64Docs,C:\C64\PDFs
ALLOWED_DOCS_DIRS=

# Set to 1 to also allow ingesting from the server process's current working
# directory (useful for `cli.py add` run from a docs folder). Off by default
# because this server is commonly registered at Claude Code user scope and
# launched with the cwd of whatever project the caller is in.
TDZ_ALLOW_CWD=0

# ============================================================
# Web Scraping Politeness
# ============================================================
# The sources this tool targets are mostly small volunteer-run wikis and
# archives. Defaults here are deliberately conservative - raise them only for
# hosts you control.
#
# User-Agent sent on every outbound request (and passed to mdscrape). Keep a
# contact URL in it so a site operator can reach you instead of just banning.
# Default: tdz-c64-knowledge/<version> (+<repo url>)
# TDZ_USER_AGENT=

# Honour robots.txt (1 = yes). Set to 0 only when you have permission to
# ignore it, e.g. scraping your own mirror. An unreachable or malformed
# robots.txt always fails open regardless of this setting.
TDZ_RESPECT_ROBOTS=1

# ============================================================
# Figure OCR (batch_ocr_figures)
# ============================================================
# Extracts embedded images from PDFs and OCRs them, making diagrams, memory
# maps and register tables searchable. Needs PyMuPDF + Tesseract + USE_OCR=1.
# Embedded images smaller than this are ignored - below roughly this size an
# image is a rule, bullet or logo fragment rather than a figure.
TDZ_FIGURE_MIN_WIDTH=120
TDZ_FIGURE_MIN_HEIGHT=120
# OCR output shorter than this is treated as noise and stored as empty, so it
# never dilutes figure search results.
TDZ_FIGURE_MIN_CHARS=12

# ============================================================
# Background Entity Extraction
# ============================================================
# Re-queue extraction jobs left behind by a process that exited mid-flight.
TDZ_RECOVER_EXTRACTION_JOBS=1
# A 'running' job with no progress for this long is treated as abandoned.
# Must stay comfortably longer than a legitimate extraction takes, since a
# live sibling process may still own the job.
TDZ_EXTRACTION_STALE_MINUTES=60
# Cap on how many orphaned jobs one startup will re-queue, so a large backlog
# doesn't kick off (potentially paid) LLM work on every session start.
TDZ_EXTRACTION_RECOVER_LIMIT=100

# ============================================================
# LLM Integration (for Smart Auto-Tagging)
# ============================================================
# LLM Provider: anthropic or openai
# Default: anthropic
LLM_PROVIDER=anthropic

# Anthropic API Key (for Claude)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (for GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Model to use
# Anthropic models: claude-haiku-4-5-20251001, claude-sonnet-5, claude-opus-4-8
# OpenAI models: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Default: claude-haiku-4-5-20251001 (fast and cost-effective)
LLM_MODEL=claude-haiku-4-5-20251001

# Per-request timeout in seconds. These calls run on the background entity
# extraction worker, so an untimed request that stalls parks that worker and
# stops every queued job behind it.
LLM_TIMEOUT_S=60
# Retries performed by the provider SDK itself (with its own backoff).
LLM_MAX_RETRIES=2

# ============================================================
# Usage Notes
# ============================================================
# 1. Copy this file to .env and configure with your values
# 2. Never commit .env to version control (it's in .gitignore)
# 3. For MCP server configuration, add these variables to the "env" section
#    in your Claude Desktop config.json or MCP settings
# 4. Restart the server after changing environment variables
