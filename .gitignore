# Temporary test files (the maintained suites below are tracked exceptions).
# The exceptions are root-anchored (leading /) on purpose: an unanchored
# `!test_rest_api.py` also un-ignores archive/tests/test_rest_api.py, which
# drags the whole archived suite back into git status.
test_*.py
!/test_card_updates.py
!/test_pdf_viewer.py
!/test_mcp_startup.py
!/test_embeddings_reliability.py
!/test_scrape_reliability.py
!/test_mcp_tool_dispatch.py
!/test_rest_api.py
!/test_wiki_safety.py
!/test_scrape_politeness.py
!/test_figure_ocr.py
!/test_llm_integration.py
!/test_serialization.py
!/test_admin_gui.py
!/test_sid_ingest.py
!/test_repoint_document.py
!/test_cross_process_lock.py
!/test_fts5_search.py
!/test_groundedness.py
!/test_hybrid_fusion.py
!/test_rerank.py
!/test_retrieval_quality.py
!/test_extract_snippet.py
!/test_markitdown_ingest.py
!/test_doc_id_dedup.py
!/test_check_url_updates.py
!/test_check_updates_progress.py
!/test_docs_dir_allowlist.py

# Un-ignore the archived test suite (archive/tests/) so it can be tracked.
# Scoped to that subdirectory specifically — NOT an unanchored basename
# exception — per the root-anchoring rationale above.
!archive/tests/test_*.py
check_*.py
reimport_*.py
debug_*.py
run_*.py
profile_*.py

